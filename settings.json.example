{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "vale@agent-tools": true
  },
  "extraKnownMarketplaces": {
    "agent-tools": {
      "source": {
        "source": "github",
        "repo": "vale-cli/agent-tools"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    }
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/hooks/outward_guard.py --agent claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/hooks/outward_guard.py --agent claude"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "conversation",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/hooks/conversation_mode.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/hooks/compose_notes.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/hooks/conversation_mode.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/hooks/compose_notes.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/hooks/compose_notes.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/bin/hooks/notify_phone.py --agent claude",
            "async": true
          }
        ]
      }
    ]
  }
}
