{
  "description": "Signature and always-OK guard for posts made under the user's account, and the compose notes for a repo's own skills. See ~/.claude/AGENTS.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/bin/hooks/outward_guard.py --agent codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/bin/hooks/outward_guard.py --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/bin/hooks/compose_notes.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
